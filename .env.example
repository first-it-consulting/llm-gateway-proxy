# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────
# Upstream (OpenAI-compatible API the proxy forwards both endpoints to)
# ──────────────────────────────────────────────────────────────────────────

# Required. Sent upstream as `Authorization: Bearer <value>`.
# On a corporate gateway this is often a static token rather than a real
# OpenAI key — any non-empty value works.
OPENAI_API_KEY="sk-your-upstream-token"

# Base URL of the upstream API, including any path prefix it expects before
# "/chat/completions" (usually "/v1").
#
# This proxy does no model-name remapping on either endpoint -- whatever
# `model` a client requests is sent upstream unchanged. Once running, GET
# /v1/models (or /models) lists what the upstream actually serves.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Set only when the upstream is Azure OpenAI. When set, OPENAI_BASE_URL
# should be the deployment endpoint instead, e.g.:
#   https://your-resource.openai.azure.com/openai/deployments/your-deployment
# AZURE_API_VERSION="2024-03-01-preview"

# ──────────────────────────────────────────────────────────────────────────
# Mutual TLS (for upstreams on a corporate network that require a client
# certificate). Leave unset to use plain HTTPS.
#
# CLIENT_CERT_PATH/CLIENT_KEY_PATH must be readable from wherever the
# process actually runs:
#   - `python start_proxy.py` (no Docker): any path on this machine, e.g.
#     an absolute path outside the repo -- nothing needs to live in ./certs.
#   - docker-compose: the container only sees ./certs (or CERTS_DIR, see
#     docker-compose.yml) mounted at /app/certs, so these must be
#     /app/certs/<filename> regardless of where the files really live.
# Prefer keeping real certs *outside* the repo (via CERTS_DIR, or an
# absolute path for local runs) over dropping them in ./certs/ -- one less
# way to ever `git add` one by accident, even though ./certs is gitignored.
# ──────────────────────────────────────────────────────────────────────────

# Host directory docker-compose mounts to /app/certs. Defaults to ./certs
# (inside this repo, gitignored) if unset; point it at an external
# directory instead to avoid keeping cert files in the repo at all.
# CERTS_DIR="/absolute/path/to/your/certs"

# Option A — separate certificate and key files:
# CLIENT_CERT_PATH="/app/certs/client.crt"
# CLIENT_KEY_PATH="/app/certs/client.key"

# Option B — single combined PEM (certificate + key in one file):
# CLIENT_CERT_PATH="/app/certs/client.pem"

# Custom CA bundle to verify the upstream's server certificate, if it isn't
# signed by a public CA (e.g. an internal corporate CA).
# CA_BUNDLE_PATH="/app/certs/corporate-ca.pem"

# Set to "false" to disable upstream certificate verification.
# Only for local debugging — never disable this in production.
# SSL_VERIFY="true"

# ──────────────────────────────────────────────────────────────────────────
# Client-facing auth (protects this proxy itself; independent of
# OPENAI_API_KEY, which authenticates the proxy to the upstream)
# ──────────────────────────────────────────────────────────────────────────

# When set, clients must send this value via the `x-api-key` header or as an
# `Authorization: Bearer <value>` header. Leave unset to disable this check.
# PROXY_API_KEY="a-shared-secret-your-clients-must-send"

# ──────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────

HOST="0.0.0.0"
PORT="8082"
LOG_LEVEL="INFO" # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ──────────────────────────────────────────────────────────────────────────
# Limits & timeouts
# ──────────────────────────────────────────────────────────────────────────

MAX_TOKENS_LIMIT="4096"
MIN_TOKENS_LIMIT="100"
REQUEST_TIMEOUT="90"
MAX_RETRIES="2"

# ──────────────────────────────────────────────────────────────────────────
# Custom headers injected into every upstream request.
# CUSTOM_HEADER_X_CLIENT_ID becomes the header "X-Client-Id".
# ──────────────────────────────────────────────────────────────────────────

# CUSTOM_HEADER_X_CLIENT_ID="my-client-id"
